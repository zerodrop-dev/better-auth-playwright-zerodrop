# Better Auth
BETTER_AUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
# An address on a domain you've verified in Resend (https://resend.com/domains).
# Resend's shared onboarding@resend.dev only sends to your own account's address.
RESEND_FROM="Auth <auth@yourdomain.com>"

# ZeroDrop: a free key from https://zerodrop.dev/keys (sign in with GitHub).
# Without one, one sender can reach only 5 different inboxes a day, and a full
# run of these tests uses more than that.
ZERODROP_API_KEY=

# Database
DATABASE_URL=file:./dev.db
